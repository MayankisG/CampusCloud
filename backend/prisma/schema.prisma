generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id          Int     @id @default(autoincrement())
  firebaseUid String  @unique
  email       String  @unique
  name        String?
  role        String
  univId      String?
  password    String?

  @@map("users")
}

model Student {
  id                  Int       @id @default(autoincrement())
  name                String?
  course              String?
  branch              String?
  semester            Int?
  year                Int?
  enrollmentCode      String?
  enrollmentCompleted Boolean?
  rollNo              String?
  firebaseUid         String?   @unique
  dob                 DateTime? @db.Date
  contactNo           BigInt?
  address             String?
  gender              String?
  nationality         String?
  bloodGroup          String?
  parentContactNo     BigInt?
  parentName          String?
  parentOccupation    String?
  email               String    @unique
  univId              String?   @unique @map("univ_id")
  stuImage            Bytes?    @db.LongBlob
  password            String?

  // Relations
  enrolledSubjects    SubjectEnrollment[] @relation("subject_student_enrollment")
  attendances         Attendance[]

  @@map("student")
}

model Faculty {
  id                  Int       @id @default(autoincrement())
  name                String?
  univId              String?   @unique @map("univ_id")
  firebaseUid         String?   @unique
  department          String?
  email               String    @unique
  dob                 DateTime? @db.Date
  contactNo           BigInt?
  address             String?
  gender              String?
  nationality         String?
  bloodGroup          String?
  image               Bytes?    @db.LongBlob
  password            String?

  // Relations
  taughtSubjects      SubjectEnrollment[]
  markedAttendances   Attendance[]

  @@map("faculty")
}

model Admin {
  id          Int       @id @default(autoincrement())
  name        String?
  univId      String?
  email       String?   @unique
  dob         DateTime? @db.Date
  password    String?
  firebaseUid String    @unique

  @@map("admin")
}

model Announcement {
  id      Int     @id @default(autoincrement())
  message String?

  @@map("announcement")
}

model SubjectEnrollment {
  id            Int     @id @default(autoincrement())
  subjectName   String?
  subjectCode   String?
  credits       Int?

  // Relation to Faculty via email
  facultyEmail  String?
  faculty       Faculty?  @relation(fields: [facultyEmail], references: [email])

  // Many-to-Many with Student
  enrolledStudents Student[] @relation("subject_student_enrollment")

  // One-to-Many with Attendance
  attendances      Attendance[]

  @@map("subject_enrollment")
}

model Attendance {
  id            Int       @id @default(autoincrement())
  
  studentEmail  String?
  student       Student?  @relation(fields: [studentEmail], references: [email])

  facultyEmail  String?
  faculty       Faculty?  @relation(fields: [facultyEmail], references: [email])

  subjectId     Int?
  subject       SubjectEnrollment? @relation(fields: [subjectId], references: [id])

  date          DateTime? @db.Date
  present       Boolean?
  remarks       String?

  @@map("attendance")
}

model Calendar {
  id          Int       @id @default(autoincrement())
  title       String?
  fileName    String?
  fileData    Bytes?    @db.LongBlob
  lastUpdated DateTime?

  @@map("calendar")
}
